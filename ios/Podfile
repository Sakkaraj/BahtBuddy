# CocoaPods is optional. This project also supports Swift Package Manager.
# On a Mac, prefer: flutter pub get && flutter run
# If a plugin needs CocoaPods, run: pod install

platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. Run flutter pub get first."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Run flutter pub get."
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

tesseract_plugin_ios = File.join(__dir__, '.symlinks', 'plugins', 'tesseract_ocr', 'ios')
libtesseract_vendor = File.join(__dir__, 'vendor', 'libtesseract')

target 'Runner' do
  use_frameworks! :linkage => :static

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # tesseract_ocr depends on SwiftyTesseract401, which is not on CocoaPods trunk.
  # Use the plugin's local podspec and the vendored libtesseract xcframework.
  pod 'SwiftyTesseract401', :podspec => File.join(tesseract_plugin_ios, 'SwiftyTesseract401.podspec')
  pod 'libtesseract', :path => libtesseract_vendor

  target 'RunnerTests' do
    inherit! :search_paths
  end
end


post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end
end
